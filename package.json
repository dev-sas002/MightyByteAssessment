{
  "name": "ride-share-backend",
  "version": "1.0.0",
  "description": "Real-time driver location tracking backend (MightyByte take-home): REST + Socket.IO",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "NODE_ENV=test node --test --test-reporter=spec \"tests/*.test.js\"",
    "test:watch": "NODE_ENV=test node --test --watch \"tests/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"frontend/src/**/*.{js,jsx}\" frontend/vite.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"frontend/src/**/*.{js,jsx}\" frontend/vite.config.js"
  },
  "keywords": [
    "ride-sharing",
    "real-time",
    "websockets",
    "socket.io",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2"
  }
}
